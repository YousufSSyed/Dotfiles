{
    "description": "CMD + Page up & down to CTRL Page up & down",
    "manipulators": [
        {
            "from": {
                "key_code": "page_up",
                "modifiers": {
                    "mandatory": ["left_command"],
                    "optional": ["any"]
                }
            },
            "to": [
                {
                    "key_code": "page_up",
                    "modifiers": ["control"]
                }
            ],
            "type": "basic"
        },
        {
            "from": {
                "key_code": "page_down",
                "modifiers": {
                    "mandatory": ["left_command"],
                    "optional": ["any"]
                }
            },
            "to": [
                {
                    "key_code": "page_down",
                    "modifiers": ["control"]
                }
            ],
            "type": "basic"
        }
    ]
}
